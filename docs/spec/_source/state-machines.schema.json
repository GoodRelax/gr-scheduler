{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/GoodRelax/gr-scheduler/docs/spec/_source/state-machines.schema.json",
 "$comment": [
  "HAND-WRITTEN CONTRACT -- EDIT THIS FILE.",
  "Validates _source/state-machines.json, which is the single source of truth. Same role as _source/settings.schema.json.",
  "The shape only. What the manuscript may hold is table T-250 of docs/spec/05-07-design.md; the cross-entry rules (evidence ids defined, states and events resolved, every target a state of the same machine, one initial state per union, machine names unique, no event key in two regions) are checked by the generators, because a schema cannot see another entry."
 ],
 "title": "The state-machine manuscript",
 "description": "Per region: the events it receives (defined once), the values its root carries, and one state machine per orthogonal concern -- its states and its state transition table keyed event -> current state -> cell. docs/spec/_assets/tbl-state-machines.md and the generated region of each region unit are printed from it.",
 "type": "object",
 "required": ["regions"],
 "additionalProperties": false,
 "properties": {
  "$schema": {"type": "string"},
  "$comment": {
   "description": "Notes for whoever edits this manuscript. JSON carries no comments, so the role declaration goes here. Not rendered.",
   "type": "array",
   "items": {"type": "string"}
  },
  "priorities": {"$ref": "#/$defs/priorities"},
  "regions": {
   "type": "array",
   "minItems": 1,
   "items": {"$ref": "#/$defs/region"}
  }
 },
 "$defs": {
  "priorities": {
   "description": "SD-4: the order across regions in which the contested keys are consumed (table T-283). Each rung names the states that stand on it; the order itself is the requirement rows the rung cites.",
   "type": "object",
   "required": ["table", "rungs"],
   "additionalProperties": false,
   "properties": {
    "table": {"$ref": "#/$defs/caption"},
    "rungs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rung"}}
   }
  },
  "rung": {
   "description": "One rung: the key or keys it contests, its words (for Esc, the words of the chain IN-4 writes), the states standing on it, and the rows that decided its place. Rungs of one key are listed first to last.",
   "type": "object",
   "required": ["id", "keys", "rung", "states", "evidence"],
   "additionalProperties": false,
   "properties": {
    "id": {"$ref": "#/$defs/rowId"},
    "keys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rung": {"$ref": "#/$defs/text"},
    "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rungState"}},
    "also": {"$ref": "#/$defs/text"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowId"}},
    "note": {"$ref": "#/$defs/text"}
   }
  },
  "rungState": {
   "description": "A state standing on a rung: one state, or every top-level state of a machine but one.",
   "oneOf": [
    {
     "type": "object",
     "required": ["in"],
     "additionalProperties": false,
     "properties": {"in": {"$ref": "#/$defs/stateId"}}
    },
    {
     "type": "object",
     "required": ["machine", "except"],
     "additionalProperties": false,
     "properties": {
      "machine": {"$ref": "#/$defs/machineName"},
      "except": {"$ref": "#/$defs/stateKey"}
     }
    }
   ]
  },
  "text": {
   "description": "Printed prose, held per language.",
   "type": "object",
   "required": ["ja"],
   "additionalProperties": false,
   "properties": {
    "ja": {"type": "string", "minLength": 1},
    "en": {"type": "string", "minLength": 1}
   }
  },
  "rowId": {"type": "string", "pattern": "^[A-Z][A-Za-z]*-[0-9]+[a-z]?$"},
  "identifier": {"type": "string", "pattern": "^[a-z][A-Za-z0-9]*$"},
  "machineName": {
   "description": "The definition's name: a noun phrase naming what the machine tracks, then StateMachine (R4.4). Unique across every region. The code holds its current state under the same noun phrase plus State.",
   "type": "string",
   "pattern": "^[a-z][A-Za-z0-9]*StateMachine$"
  },
  "stateKey": {
   "description": "A state's key inside its machine: one word, or its parent's key and one more word. It reads 'the machine is now <state>' (R4.4).",
   "type": "string",
   "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*$"
  },
  "stateId": {
   "description": "A state named across machines: the machine name, then the state key.",
   "type": "string",
   "pattern": "^[a-z][A-Za-z0-9]*StateMachine(\\.[a-z][A-Za-z0-9]*)+$"
  },
  "targetKey": {
   "description": "Where a cell leads: a state key of the same machine, or {name} -- a value the event carries, standing for any top-level kind of the machine but its initial one.",
   "type": "string",
   "pattern": "^([a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)*|\\{[a-z][A-Za-z0-9]*\\})$"
  },
  "caption": {
   "type": "object",
   "required": ["id", "caption"],
   "additionalProperties": false,
   "properties": {
    "id": {"type": "string", "pattern": "^[TF]-[0-9]+[a-z]?$"},
    "caption": {"$ref": "#/$defs/text"}
   }
  },
  "carry": {
   "description": "The NAME of a value the state or event carries (SD-1, SD-2). Its type is the code's.",
   "type": "object",
   "required": ["name"],
   "additionalProperties": false,
   "properties": {
    "name": {"$ref": "#/$defs/identifier"},
    "rows": {"type": "array", "items": {"$ref": "#/$defs/rowId"}},
    "note": {"$ref": "#/$defs/text"}
   }
  },
  "region": {
   "type": "object",
   "required": ["region", "name", "unit", "typeStem", "table", "figure", "root", "events", "machines"],
   "additionalProperties": false,
   "properties": {
    "region": {"$ref": "#/$defs/identifier"},
    "name": {"$ref": "#/$defs/text"},
    "unit": {"type": "string", "pattern": "^src/.+\\.ts$"},
    "typeStem": {"type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$"},
    "table": {"$ref": "#/$defs/caption"},
    "figure": {"$ref": "#/$defs/caption"},
    "root": {"$ref": "#/$defs/root"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "machines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/machine"}}
   }
  },
  "root": {
   "description": "The region's root: the values it carries beside its machines, and the events that only rewrite those values (a cell without `to`).",
   "type": "object",
   "required": ["carries", "evidence", "transitions"],
   "additionalProperties": false,
   "properties": {
    "carries": {"type": "array", "items": {"$ref": "#/$defs/carry"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowId"}},
    "transitions": {
     "type": "object",
     "propertyNames": {"$ref": "#/$defs/identifier"},
     "additionalProperties": {"$ref": "#/$defs/rootCell"}
    }
   }
  },
  "event": {
   "description": "SD-2 of table T-250. Defined once per region; its id is region/key.",
   "type": "object",
   "required": ["key", "source", "carries"],
   "additionalProperties": false,
   "properties": {
    "key": {"$ref": "#/$defs/identifier"},
    "source": {
     "type": "object",
     "required": ["kind", "rows"],
     "additionalProperties": false,
     "properties": {
      "kind": {"enum": ["input", "effectResult", "otherRegion", "time"]},
      "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowId"}},
      "note": {"$ref": "#/$defs/text"}
     }
    },
    "carries": {"type": "array", "items": {"$ref": "#/$defs/carry"}}
   }
  },
  "machine": {
   "description": "One state machine: its states (SD-1) and its state transition table (SD-3), keyed event -> current state -> cell. An absent cell leaves the machine unchanged, at the same reference.",
   "type": "object",
   "required": ["name", "states", "transitions"],
   "additionalProperties": false,
   "properties": {
    "name": {"$ref": "#/$defs/machineName"},
    "states": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/state"}},
    "transitions": {
     "type": "object",
     "minProperties": 1,
     "propertyNames": {"$ref": "#/$defs/identifier"},
     "additionalProperties": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/stateKey"},
      "additionalProperties": {"$ref": "#/$defs/cell"}
     }
    }
   }
  },
  "state": {
   "description": "SD-1 of table T-250. Its id is machine.key.",
   "type": "object",
   "required": ["key", "parent", "initial", "carries", "evidence"],
   "additionalProperties": false,
   "properties": {
    "key": {"$ref": "#/$defs/stateKey"},
    "parent": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/stateKey"}]},
    "initial": {"type": "boolean"},
    "carries": {"type": "array", "items": {"$ref": "#/$defs/carry"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowId"}}
   }
  },
  "guardTerm": {
   "description": "A named guard (its expression is the code's), or a state another machine of the same region must be in.",
   "oneOf": [
    {
     "type": "object",
     "required": ["name"],
     "additionalProperties": false,
     "properties": {
      "name": {"$ref": "#/$defs/identifier"},
      "not": {"const": true}
     }
    },
    {
     "type": "object",
     "required": ["in"],
     "additionalProperties": false,
     "properties": {
      "in": {"$ref": "#/$defs/stateId"}
     }
    }
   ]
  },
  "branch": {
   "description": "One outcome of a cell. `to` equal to the current state is a transition to itself (the kind stays, carried values may be rewritten).",
   "type": "object",
   "required": ["to", "evidence"],
   "additionalProperties": false,
   "properties": {
    "to": {"$ref": "#/$defs/targetKey"},
    "guard": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/guardTerm"}},
    "effect": {"$ref": "#/$defs/identifier"},
    "effectArgument": {"$ref": "#/$defs/rowId"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowId"}},
    "note": {"$ref": "#/$defs/text"}
   }
  },
  "cell": {
   "description": "One branch, or two or more branches told apart by their guards.",
   "oneOf": [
    {"$ref": "#/$defs/branch"},
    {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/branch"}}
   ]
  },
  "rootBranch": {
   "type": "object",
   "required": ["evidence"],
   "additionalProperties": false,
   "properties": {
    "guard": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/guardTerm"}},
    "effect": {"$ref": "#/$defs/identifier"},
    "effectArgument": {"$ref": "#/$defs/rowId"},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rowId"}},
    "note": {"$ref": "#/$defs/text"}
   }
  },
  "rootCell": {
   "oneOf": [
    {"$ref": "#/$defs/rootBranch"},
    {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/rootBranch"}}
   ]
  }
 }
}
