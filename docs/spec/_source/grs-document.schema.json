{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/GoodRelax/gr-scheduler/docs/spec/_source/grs-document.schema.json",
 "title": "GRS JSON document",
 "description": "Generated from docs/spec/_source/erd.json (the schedule group) and docs/spec/_assets/tbl-settings.md (the presentation group). Never edit by hand. Rebuild: npm run gen -- npm run gen:check fails on drift. The generator is docs/spec/_source/erd_json_to_schema.py.",
 "type": "object",
 "required": [
  "schemaVersion",
  "schedule",
  "documentSettings",
  "documentStamp",
  "changeLog"
 ],
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {
   "type": "string"
  },
  "schedule": {
   "type": "object",
   "description": "The schedule group (DR-2 of table T-052).",
   "required": [
    "project",
    "calendars",
    "tasks",
    "resources",
    "assignments",
    "taskGroups",
    "taskGroupMembers",
    "taskVisuals",
    "commentBoxes",
    "highlightBoxes",
    "taskOrigins",
    "baselineTasks"
   ],
   "additionalProperties": false,
   "properties": {
    "project": {
     "$ref": "#/$defs/Project"
    },
    "calendars": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Calendar"
     }
    },
    "tasks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Task"
     }
    },
    "resources": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Resource"
     }
    },
    "assignments": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Assignment"
     }
    },
    "taskGroups": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskGroup"
     }
    },
    "taskGroupMembers": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskGroupMember"
     }
    },
    "taskVisuals": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskVisual"
     }
    },
    "commentBoxes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CommentBox"
     }
    },
    "highlightBoxes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/HighlightBox"
     }
    },
    "taskOrigins": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskOrigin"
     }
    },
    "baselineTasks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/BaselineTask"
     }
    }
   }
  },
  "documentSettings": {
   "type": "object",
   "description": "The presentation group (DR-3 of table T-052). FR-063 fixes what is in it.",
   "required": [
    "actualVisible",
    "assigneeVisible",
    "baselineVisible",
    "dateGridLinesVisible",
    "dependencyVisible",
    "displayScale",
    "fontScale",
    "groupGridLinesVisible",
    "levelZeroTreeState",
    "percentCompleteVisible",
    "pinnedGroupIds",
    "planDatesVisible",
    "planVisible",
    "progressLineVisible",
    "progressMarkerVisible",
    "rowTitlePanelWidth",
    "rulerFont",
    "rulerHeight",
    "scrollDate",
    "scrollDayOffset",
    "scrollGroupId",
    "scrollGroupOffset",
    "stackDirection",
    "themeMonochrome",
    "zoomX",
    "zoomY"
   ],
   "additionalProperties": false,
   "properties": {
    "actualVisible": {
     "type": "boolean"
    },
    "assigneeVisible": {
     "type": "boolean"
    },
    "baselineVisible": {
     "type": "boolean"
    },
    "dateGridLinesVisible": {
     "type": "boolean"
    },
    "dependencyVisible": {
     "type": "boolean"
    },
    "displayScale": {
     "enum": [
      50,
      67,
      75,
      90,
      100,
      110,
      125,
      150,
      175,
      200
     ]
    },
    "fontScale": {
     "enum": [
      "S",
      "M",
      "L"
     ]
    },
    "groupGridLinesVisible": {
     "type": "boolean"
    },
    "levelZeroTreeState": {
     "enum": [
      "auto",
      "collapsed"
     ]
    },
    "percentCompleteVisible": {
     "type": "boolean"
    },
    "pinnedGroupIds": {
     "type": "array",
     "items": {
      "type": "string",
      "format": "uuid"
     }
    },
    "planDatesVisible": {
     "type": "boolean"
    },
    "planVisible": {
     "type": "boolean"
    },
    "progressLineVisible": {
     "type": "boolean"
    },
    "progressMarkerVisible": {
     "type": "boolean"
    },
    "rowTitlePanelWidth": {
     "type": "number"
    },
    "rulerFont": {
     "type": "number"
    },
    "rulerHeight": {
     "type": "number",
     "maximum": 150
    },
    "scrollDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "scrollDayOffset": {
     "type": "number"
    },
    "scrollGroupId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "scrollGroupOffset": {
     "type": "number"
    },
    "stackDirection": {
     "enum": [
      "up",
      "down"
     ]
    },
    "themeMonochrome": {
     "type": "boolean"
    },
    "zoomX": {
     "type": "number"
    },
    "zoomY": {
     "type": "number"
    }
   }
  },
  "documentStamp": {
   "$ref": "#/$defs/documentStamp"
  },
  "changeLog": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/changeLog"
   }
  }
 },
 "$defs": {
  "Project": {
   "type": "object",
   "description": "The project's own particulars, and the calendar defaults that apply to the whole document.",
   "required": [
    "id",
    "name",
    "title",
    "subject",
    "category",
    "company",
    "manager",
    "author",
    "created",
    "revision",
    "lastSaved",
    "startDate",
    "statusDate",
    "minutesPerDay",
    "minutesPerWeek",
    "daysPerMonth",
    "weekStartDay",
    "calendarUid",
    "themeHue",
    "uidHighWaterMark",
    "importSeq",
    "carry",
    "carryElements",
    "outlineBase",
    "sourceFormat"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 16
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "title": {
     "type": [
      "string",
      "null"
     ]
    },
    "subject": {
     "type": [
      "string",
      "null"
     ]
    },
    "category": {
     "type": [
      "string",
      "null"
     ]
    },
    "company": {
     "type": [
      "string",
      "null"
     ]
    },
    "manager": {
     "type": [
      "string",
      "null"
     ]
    },
    "author": {
     "type": [
      "string",
      "null"
     ]
    },
    "created": {
     "type": [
      "string",
      "null"
     ]
    },
    "revision": {
     "type": [
      "integer",
      "null"
     ]
    },
    "lastSaved": {
     "type": [
      "string",
      "null"
     ]
    },
    "startDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "statusDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "minutesPerDay": {
     "type": [
      "integer",
      "null"
     ]
    },
    "minutesPerWeek": {
     "type": [
      "integer",
      "null"
     ]
    },
    "daysPerMonth": {
     "type": [
      "integer",
      "null"
     ]
    },
    "weekStartDay": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 6
    },
    "calendarUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "themeHue": {
     "type": "integer",
     "minimum": 0,
     "maximum": 359
    },
    "uidHighWaterMark": {
     "type": "integer"
    },
    "importSeq": {
     "type": "integer"
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    },
    "outlineBase": {
     "type": "integer",
     "default": 1
    },
    "sourceFormat": {
     "enum": [
      "grs",
      "pj12",
      "pj15"
     ]
    }
   }
  },
  "Task": {
   "type": "object",
   "description": "One task. The plan and the actual are held by the same row.",
   "required": [
    "uid",
    "wbsParentUid",
    "wbsOrder",
    "name",
    "start",
    "finish",
    "milestone",
    "deadline",
    "notes",
    "calendarUid",
    "actualStart",
    "stop",
    "actualFinish",
    "resume",
    "resumeValid",
    "percentComplete",
    "fadeInDays",
    "fadeOutDays",
    "dependencies",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "wbsParentUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "wbsOrder": {
     "type": [
      "integer",
      "null"
     ]
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "start": {
     "type": [
      "string",
      "null"
     ]
    },
    "finish": {
     "type": [
      "string",
      "null"
     ]
    },
    "milestone": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "deadline": {
     "type": [
      "string",
      "null"
     ]
    },
    "notes": {
     "type": [
      "string",
      "null"
     ]
    },
    "calendarUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "actualStart": {
     "type": [
      "string",
      "null"
     ]
    },
    "stop": {
     "type": [
      "string",
      "null"
     ]
    },
    "actualFinish": {
     "type": [
      "string",
      "null"
     ]
    },
    "resume": {
     "type": [
      "string",
      "null"
     ]
    },
    "resumeValid": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "percentComplete": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "fadeInDays": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "fadeOutDays": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "dependencies": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Dependency"
     }
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Dependency": {
   "type": "object",
   "description": "One dependency. **Nested under the task that succeeds it.**",
   "required": [
    "predecessorUid",
    "linkType",
    "lag",
    "lagFormat",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "predecessorUid": {
     "type": "integer"
    },
    "linkType": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "lag": {
     "type": [
      "integer",
      "null"
     ]
    },
    "lagFormat": {
     "type": [
      "integer",
      "null"
     ]
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "TaskGroup": {
   "type": "object",
   "description": "A row, and the container that gives stacking its axis (`FR-004`).",
   "required": [
    "id",
    "parentId",
    "label",
    "derivedFromTaskUid",
    "order",
    "treeState",
    "editGroup",
    "color",
    "minHeight"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "parentId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    },
    "derivedFromTaskUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "order": {
     "type": "integer"
    },
    "treeState": {
     "enum": [
      "auto",
      "collapsed",
      "expanded",
      "temporarilyExpanded",
      "hidden"
     ],
     "default": "auto"
    },
    "editGroup": {
     "type": [
      "string",
      "null"
     ]
    },
    "color": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "minHeight": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "TaskGroupMember": {
   "type": "object",
   "description": "Which task sits on which row, and at which stacking position.",
   "required": [
    "taskUid",
    "groupId",
    "stackOrder"
   ],
   "additionalProperties": false,
   "properties": {
    "taskUid": {
     "type": "integer"
    },
    "groupId": {
     "type": "string",
     "format": "uuid"
    },
    "stackOrder": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "Calendar": {
   "type": "object",
   "description": "One calendar. Decides which days are worked and which are not.",
   "required": [
    "uid",
    "name",
    "isBaseCalendar",
    "baseCalendarUid",
    "ordinal",
    "carry",
    "carryElements",
    "weekDays",
    "exceptions"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "isBaseCalendar": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "baseCalendarUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "ordinal": {
     "type": "integer"
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    },
    "weekDays": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/WeekDay"
     }
    },
    "exceptions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Exception"
     }
    }
   }
  },
  "WeekDay": {
   "type": "object",
   "description": "What one day of the week is worked as (a weak entity).",
   "required": [
    "ordinal",
    "dayType",
    "dayWorking",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "ordinal": {
     "type": "integer"
    },
    "dayType": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 7
    },
    "dayWorking": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Exception": {
   "type": "object",
   "description": "One exception day of a calendar (a weak entity).",
   "required": [
    "ordinal",
    "name",
    "fromDate",
    "toDate",
    "dayWorking",
    "recurrenceKind",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "ordinal": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "fromDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "toDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "dayWorking": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "recurrenceKind": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 9
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Resource": {
   "type": "object",
   "description": "One person to assign work to, or one resource.",
   "required": [
    "uid",
    "name",
    "resourceKind",
    "isCostResource",
    "calendarUid",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "resourceKind": {
     "type": [
      "integer",
      "null"
     ]
    },
    "isCostResource": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "calendarUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Assignment": {
   "type": "object",
   "description": "Which person is on which task.",
   "required": [
    "uid",
    "taskUid",
    "resourceUid",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "taskUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "resourceUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "carry": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "TaskVisual": {
   "type": "object",
   "description": "How a task is drawn: its shape, its colours and where its name sits.",
   "required": [
    "taskUid",
    "shapeKind",
    "milestoneGlyph",
    "fillColor",
    "strokeColor",
    "strokeWidthPx"
   ],
   "additionalProperties": false,
   "properties": {
    "taskUid": {
     "type": "integer"
    },
    "shapeKind": {
     "enum": [
      "rectangle",
      "chevron",
      "arrow",
      "endpointSpan",
      "milestone",
      null
     ]
    },
    "milestoneGlyph": {
     "enum": [
      "circle",
      "hexagon",
      "pentagon",
      "diamond",
      "square",
      "star",
      "triangleUp",
      "triangleDown",
      "file",
      "box",
      "floppyDisk",
      "cylinder",
      "person",
      "smile",
      "beerMug",
      null
     ],
     "default": "diamond"
    },
    "fillColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "strokeColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "strokeWidthPx": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 10
    }
   }
  },
  "TaskOrigin": {
   "type": "object",
   "description": "What an import brought this task from. Used to match rows when merging.",
   "required": [
    "taskUid",
    "sourceProjectUid",
    "sourceUid",
    "lastSeenImportSeq",
    "importSessionId"
   ],
   "additionalProperties": false,
   "properties": {
    "taskUid": {
     "type": "integer"
    },
    "sourceProjectUid": {
     "type": [
      "string",
      "null"
     ]
    },
    "sourceUid": {
     "type": "integer"
    },
    "lastSeenImportSeq": {
     "type": "integer"
    },
    "importSessionId": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "CommentBox": {
   "type": "object",
   "description": "One comment box. Pinned to a date and a row.",
   "required": [
    "id",
    "leaderShapeKind",
    "text",
    "anchorDate",
    "anchorGroupId",
    "bodyOffsetPx",
    "strokeColor",
    "strokeWidthPx",
    "fillColor",
    "fillTransparencyPercent",
    "textColor"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
