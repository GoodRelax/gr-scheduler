     "type": "string"
    },
    "changedUtc": {
     "type": "string",
     "format": "date-time",
     "$comment": "ISO 8601, UTC, to the second."
    }
   }
  },
  "BaselineTask": {
   "type": "object",
   "description": "One task of an earlier plan, matched to the current task by uid and drawn only as an outline over it.",
   "required": [
