{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/GoodRelax/gr-scheduler/docs/spec/_source/grs-document.schema.json",
 "$comment": "Generated from docs/spec/_source/erd.json (the schedule group) and docs/spec/_assets/tbl-settings.md with docs/spec/_source/settings.json (the presentation group). Never edit by hand. Rebuild: npm run gen -- npm run gen:check fails on drift. The generator is docs/spec/_source/erd_json_to_schema.py.",
 "title": "GRS JSON document",
 "description": "A GRS schedule document. `schedule` is the data; `documentSettings` is how it is drawn when opened; `documentStamp` and `changeLog` record when, by whom and why it changed. Every key is written, null included, so that \"the source had no value\" and \"the value is 0\" are never confused. What comes from MS Project XML (MSPDI) keeps its names and codes, so that a round trip loses nothing. Dates are local date-times without a zone, as MS Project writes them; GRS uses only the day for now and writes 00:00:00, and a last day (finish, actualFinish, stop, endDate) is included. A null colour or width follows the theme. A custom colour gives the light-theme and the dark-theme value (\"#light/#dark\"; an empty side is drawn with the other), because a readable dark colour cannot be derived from a light one.",
 "type": "object",
 "required": [
  "schemaVersion",
  "schedule",
  "documentSettings",
  "documentStamp",
  "changeLog"
 ],
 "additionalProperties": false,
 "properties": {
  "schemaVersion": {
   "type": "string"
  },
  "schedule": {
   "type": "object",
   "description": "The data: what is exported to MS Project, and what GRS adds to draw it.",
   "required": [
    "project",
    "calendars",
    "tasks",
    "resources",
    "assignments",
    "taskGroups",
    "taskGroupMembers",
    "taskVisuals",
    "commentBoxes",
    "highlightBoxes",
    "taskOrigins",
    "baselineTasks"
   ],
   "additionalProperties": false,
   "properties": {
    "project": {
     "$ref": "#/$defs/Project"
    },
    "calendars": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Calendar"
     }
    },
    "tasks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Task"
     }
    },
    "resources": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Resource"
     }
    },
    "assignments": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Assignment"
     }
    },
    "taskGroups": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskGroup"
     }
    },
    "taskGroupMembers": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskGroupMember"
     }
    },
    "taskVisuals": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskVisual"
     }
    },
    "commentBoxes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CommentBox"
     }
    },
    "highlightBoxes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/HighlightBox"
     }
    },
    "taskOrigins": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskOrigin"
     }
    },
    "baselineTasks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/BaselineTask"
     }
    }
   }
  },
  "documentSettings": {
   "type": "object",
   "description": "How the document is drawn when opened. Every key is written even at its default, so that a later change of a default never changes this picture.",
   "required": [
    "actualVisible",
    "assigneeVisible",
    "baselineVisible",
    "dateGridLinesVisible",
    "dependencyVisible",
    "displayScale",
    "fontScale",
    "groupGridLinesVisible",
    "levelZeroTreeState",
    "percentCompleteVisible",
    "pinnedGroupIds",
    "planDatesVisible",
    "planVisible",
    "progressLineVisible",
    "progressMarkerVisible",
    "rowTitlePanelWidth",
    "rulerFont",
    "rulerHeight",
    "scrollDate",
    "scrollDayOffset",
    "scrollGroupId",
    "scrollGroupOffset",
    "stackDirection",
    "themeMonochrome",
    "zoomX",
    "zoomY"
   ],
   "additionalProperties": false,
   "properties": {
    "actualVisible": {
     "type": "boolean",
     "default": true
    },
    "assigneeVisible": {
     "type": "boolean",
     "default": false
    },
    "baselineVisible": {
     "type": "boolean",
     "default": false
    },
    "dateGridLinesVisible": {
     "type": "boolean",
     "default": false
    },
    "dependencyVisible": {
     "type": "boolean",
     "default": true
    },
    "displayScale": {
     "enum": [
      50,
      67,
      75,
      90,
      100,
      110,
      125,
      150,
      175,
      200
     ],
     "default": 100
    },
    "fontScale": {
     "enum": [
      "S",
      "M",
      "L"
     ],
     "default": "M"
    },
    "groupGridLinesVisible": {
     "type": "boolean",
     "default": true
    },
    "levelZeroTreeState": {
     "enum": [
      "auto",
      "collapsed"
     ],
     "default": "auto"
    },
    "percentCompleteVisible": {
     "type": "boolean",
     "default": false
    },
    "pinnedGroupIds": {
     "type": "array",
     "items": {
      "type": "string",
      "format": "uuid"
     },
     "default": []
    },
    "planDatesVisible": {
     "type": "boolean",
     "default": false
    },
    "planVisible": {
     "type": "boolean",
     "default": true
    },
    "progressLineVisible": {
     "type": "boolean",
     "default": false
    },
    "progressMarkerVisible": {
     "type": "boolean",
     "default": true
    },
    "rowTitlePanelWidth": {
     "type": "number",
     "default": 300,
     "minimum": 80
    },
    "rulerFont": {
     "type": "number",
     "default": 21,
     "minimum": 12
    },
    "rulerHeight": {
     "type": "number",
     "maximum": 150,
     "default": 69
    },
    "scrollDate": {
     "type": [
      "string",
      "null"
     ],
     "default": null
    },
    "scrollDayOffset": {
     "type": "number",
     "default": 0
    },
    "scrollGroupId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid",
     "default": null
    },
    "scrollGroupOffset": {
     "type": "number",
     "default": 0
    },
    "stackDirection": {
     "enum": [
      "up",
      "down"
     ],
     "default": "up"
    },
    "themeMonochrome": {
     "type": "boolean",
     "default": false
    },
    "zoomX": {
     "type": "number",
     "default": 1,
     "minimum": 0.02,
     "maximum": 64
    },
    "zoomY": {
     "type": "number",
     "default": 1,
     "minimum": 0.02,
     "maximum": 64
    }
   }
  },
  "documentStamp": {
   "$ref": "#/$defs/documentStamp"
  },
  "changeLog": {
   "type": "array",
   "items": {
    "$ref": "#/$defs/changeLog"
   }
  }
 },
 "$defs": {
  "Project": {
   "type": "object",
   "description": "The project's own particulars, and the calendar defaults that apply to the whole document.",
   "required": [
    "id",
    "name",
    "title",
    "subject",
    "category",
    "company",
    "manager",
    "author",
    "created",
    "revision",
    "lastSaved",
    "startDate",
    "statusDate",
    "minutesPerDay",
    "minutesPerWeek",
    "daysPerMonth",
    "weekStartDay",
    "calendarUid",
    "themeHue",
    "uidHighWaterMark",
    "importSeq",
    "carry",
    "carryElements",
    "outlineBase",
    "sourceFormat"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": [
      "string",
      "null"
     ],
     "maxLength": 16
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "title": {
     "type": [
      "string",
      "null"
     ]
    },
    "subject": {
     "type": [
      "string",
      "null"
     ]
    },
    "category": {
     "type": [
      "string",
      "null"
     ]
    },
    "company": {
     "type": [
      "string",
      "null"
     ]
    },
    "manager": {
     "type": [
      "string",
      "null"
     ]
    },
    "author": {
     "type": [
      "string",
      "null"
     ]
    },
    "created": {
     "type": [
      "string",
      "null"
     ]
    },
    "revision": {
     "type": [
      "integer",
      "null"
     ]
    },
    "lastSaved": {
     "type": [
      "string",
      "null"
     ]
    },
    "startDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "statusDate": {
     "description": "MS Project's StatusDate; the progress line is drawn on this day.",
     "type": [
      "string",
      "null"
     ]
    },
    "minutesPerDay": {
     "type": [
      "integer",
      "null"
     ]
    },
    "minutesPerWeek": {
     "type": [
      "integer",
      "null"
     ]
    },
    "daysPerMonth": {
     "type": [
      "integer",
      "null"
     ]
    },
    "weekStartDay": {
     "description": "MS Project's numbering: 0 Sunday ... 6 Saturday (one less than WeekDay.dayType).",
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0,
     "maximum": 6
    },
    "calendarUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "themeHue": {
     "description": "The hue that tasks and rows without a colour of their own are drawn in. It belongs to the project, not to the reader, so it is here and not in documentSettings.",
     "type": "integer",
     "minimum": 0,
     "maximum": 359,
     "default": 214
    },
    "uidHighWaterMark": {
     "description": "One counter for the uids of tasks, resources, assignments and calendars; uids are never reused, so new ones are taken above it.",
     "type": "integer"
    },
    "importSeq": {
     "type": "integer"
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    },
    "outlineBase": {
     "type": "integer",
     "default": 1
    },
    "sourceFormat": {
     "enum": [
      "grs",
      "pj12",
      "pj15"
     ]
    }
   }
  },
  "Task": {
   "type": "object",
   "description": "One task: its plan, and its actual given by dates.",
   "required": [
    "uid",
    "wbsParentUid",
    "wbsOrder",
    "name",
    "start",
    "finish",
    "milestone",
    "deadline",
    "notes",
    "calendarUid",
    "actualStart",
    "stop",
    "actualFinish",
    "resume",
    "resumeValid",
    "percentComplete",
    "fadeInDays",
    "fadeOutDays",
    "dependencies",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "wbsParentUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "wbsOrder": {
     "type": [
      "integer",
      "null"
     ]
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "start": {
     "type": [
      "string",
      "null"
     ]
    },
    "finish": {
     "type": [
      "string",
      "null"
     ]
    },
    "milestone": {
     "description": "The fact, exported to MS Project; TaskVisual.shapeKind only draws it and must agree with it.",
     "type": [
      "boolean",
      "null"
     ]
    },
    "deadline": {
     "type": [
      "string",
      "null"
     ]
    },
    "notes": {
     "type": [
      "string",
      "null"
     ]
    },
    "calendarUid": {
     "description": "Kept only for the MS Project round trip; working days are counted with the one calendar project.calendarUid names.",
     "type": [
      "integer",
      "null"
     ]
    },
    "actualStart": {
     "type": [
      "string",
      "null"
     ]
    },
    "stop": {
     "description": "MS Project's Stop, kept under its name for the round trip: the last day the actual has reached while the task is unfinished; null once actualFinish is set.",
     "type": [
      "string",
      "null"
     ]
    },
    "actualFinish": {
     "type": [
      "string",
      "null"
     ]
    },
    "resume": {
     "description": "MS Project's Resume: the day the rest of an interrupted task is planned to restart.",
     "type": [
      "string",
      "null"
     ]
    },
    "resumeValid": {
     "description": "MS Project's ResumeValid: false means interrupted with no restart day decided.",
     "type": [
      "boolean",
      "null"
     ]
    },
    "percentComplete": {
     "description": "Follows from the dates: round(actual length / planned length x 100), both in working days; GRS keeps it in step when dates change, so write what the dates give. Not capped at 100, because an overrun reports more.",
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "fadeInDays": {
     "description": "Days at the start of the bar, inside start..finish, drawn slanted to say the start is not yet firm; a fact about the task, so it travels to MS Project rather than living in TaskVisual.",
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "fadeOutDays": {
     "description": "As fadeInDays, for the finish.",
     "type": [
      "integer",
      "null"
     ],
     "minimum": 0
    },
    "dependencies": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Dependency"
     }
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Dependency": {
   "type": "object",
   "description": "One dependency, nested under the task that follows it, as MS Project nests it.",
   "required": [
    "predecessorUid",
    "linkType",
    "lag",
    "lagFormat",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "predecessorUid": {
     "type": "integer"
    },
    "linkType": {
     "description": "MS Project's codes: 0 finish-to-finish, 1 finish-to-start, 2 start-to-finish, 3 start-to-start.",
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    },
    "lag": {
     "description": "MS Project's LinkLag: tenths of a minute whatever lagFormat says; a working day (lagFormat 7) is project.minutesPerDay minutes.",
     "type": [
      "integer",
      "null"
     ]
    },
    "lagFormat": {
     "description": "MS Project's LagFormat: the unit the lag is shown in (7 = days).",
     "type": [
      "integer",
      "null"
     ]
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "TaskGroup": {
   "type": "object",
   "description": "A row on screen. Rows are kept apart from the WBS (Task.wbsParentUid) so that several tasks can share one row; rows are not exported to MS Project.",
   "required": [
    "id",
    "parentId",
    "label",
    "derivedFromTaskUid",
    "order",
    "treeState",
    "editGroup",
    "color",
    "minHeight"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "parentId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "label": {
     "type": [
      "string",
      "null"
     ]
    },
    "derivedFromTaskUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "order": {
     "type": "integer"
    },
    "treeState": {
     "description": "Saved, like every row state, so that reopening shows what was saved.",
     "enum": [
      "auto",
      "collapsed",
      "expanded",
      "temporarilyExpanded",
      "hidden"
     ],
     "default": "auto"
    },
    "editGroup": {
     "type": [
      "string",
      "null"
     ]
    },
    "color": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "minHeight": {
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "TaskGroupMember": {
   "type": "object",
   "description": "Which row a task sits on; every task sits on exactly one row.",
   "required": [
    "taskUid",
    "groupId",
    "stackOrder"
   ],
   "additionalProperties": false,
   "properties": {
    "taskUid": {
     "type": "integer"
    },
    "groupId": {
     "type": "string",
     "format": "uuid"
    },
    "stackOrder": {
     "description": "Not read: GRS stacks the tasks of a row automatically. Write null.",
     "type": [
      "integer",
      "null"
     ]
    }
   }
  },
  "Calendar": {
   "type": "object",
   "description": "One calendar. Decides which days are worked and which are not.",
   "required": [
    "uid",
    "name",
    "isBaseCalendar",
    "baseCalendarUid",
    "ordinal",
    "carry",
    "carryElements",
    "weekDays",
    "exceptions"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "isBaseCalendar": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "baseCalendarUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "ordinal": {
     "type": "integer"
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    },
    "weekDays": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/WeekDay"
     }
    },
    "exceptions": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Exception"
     }
    }
   }
  },
  "WeekDay": {
   "type": "object",
   "description": "Whether one day of the week is worked.",
   "required": [
    "ordinal",
    "dayType",
    "dayWorking",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "ordinal": {
     "type": "integer"
    },
    "dayType": {
     "description": "MS Project's numbering: 1 Sunday ... 7 Saturday (one more than Project.weekStartDay).",
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 7
    },
    "dayWorking": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Exception": {
   "type": "object",
   "description": "An exception to a calendar's week, possibly recurring.",
   "required": [
    "ordinal",
    "name",
    "fromDate",
    "toDate",
    "dayWorking",
    "recurrenceKind",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "ordinal": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "fromDate": {
     "description": "MS Project's start of the recurrence, not a range of real days.",
     "type": [
      "string",
      "null"
     ]
    },
    "toDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "dayWorking": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "recurrenceKind": {
     "description": "MS Project's Exception/Type: 1 daily, 2 yearly by day of the month, 3 yearly by position, 4 monthly by day of the month, 5 monthly by position, 6 weekly, 7 by day count, 8 by weekday count, 9 none.",
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 9
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Resource": {
   "type": "object",
   "description": "One person to assign work to, or one resource.",
   "required": [
    "uid",
    "name",
    "resourceKind",
    "isCostResource",
    "calendarUid",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "resourceKind": {
     "description": "MS Project's Type: 0 material, 1 work, 2 cost.",
     "type": [
      "integer",
      "null"
     ]
    },
    "isCostResource": {
     "type": [
      "boolean",
      "null"
     ]
    },
    "calendarUid": {
     "description": "As Task.calendarUid.",
     "type": [
      "integer",
      "null"
     ]
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "Assignment": {
   "type": "object",
   "description": "Which person is on which task.",
   "required": [
    "uid",
    "taskUid",
    "resourceUid",
    "carry",
    "carryElements"
   ],
   "additionalProperties": false,
   "properties": {
    "uid": {
     "type": "integer"
    },
    "taskUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "resourceUid": {
     "type": [
      "integer",
      "null"
     ]
    },
    "carry": {
     "$ref": "#/$defs/Carry"
    },
    "carryElements": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "TaskVisual": {
   "type": "object",
   "description": "How a task is drawn: its shape and its colours.",
   "required": [
    "taskUid",
    "shapeKind",
    "milestoneGlyph",
    "fillColor",
    "strokeColor",
    "strokeWidthPx"
   ],
   "additionalProperties": false,
   "properties": {
    "taskUid": {
     "type": "integer"
    },
    "shapeKind": {
     "enum": [
      "rectangle",
      "chevron",
      "arrow",
      "endpointSpan",
      "milestone",
      null
     ]
    },
    "milestoneGlyph": {
     "enum": [
      "circle",
      "hexagon",
      "pentagon",
      "diamond",
      "square",
      "star",
      "triangleUp",
      "triangleDown",
      "file",
      "box",
      "floppyDisk",
      "cylinder",
      "person",
      "smile",
      "beerMug",
      null
     ],
     "default": "diamond"
    },
    "fillColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "strokeColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "strokeWidthPx": {
     "type": [
      "integer",
      "null"
     ],
     "minimum": 1,
     "maximum": 10
    }
   }
  },
  "TaskOrigin": {
   "type": "object",
   "description": "Where an imported task came from, so that importing the same file again updates the task instead of adding a copy.",
   "required": [
    "taskUid",
    "sourceProjectUid",
    "sourceUid",
    "lastSeenImportSeq",
    "importSessionId"
   ],
   "additionalProperties": false,
   "properties": {
    "taskUid": {
     "type": "integer"
    },
    "sourceProjectUid": {
     "type": [
      "string",
      "null"
     ]
    },
    "sourceUid": {
     "type": "integer"
    },
    "lastSeenImportSeq": {
     "type": "integer"
    },
    "importSessionId": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "CommentBox": {
   "type": "object",
   "description": "One comment box. Pinned to a date and a row.",
   "required": [
    "id",
    "leaderShapeKind",
    "text",
    "anchorDate",
    "anchorGroupId",
    "bodyOffsetPx",
    "strokeColor",
    "strokeWidthPx",
    "fillColor",
    "fillTransparencyPercent",
    "textColor"
   ],
   "additionalProperties": false,
   "properties": {
    "id": {
     "type": "string",
     "format": "uuid"
    },
    "leaderShapeKind": {
     "enum": [
      "calloutBox",
      "polyline",
      null
     ]
    },
    "text": {
     "type": [
      "string",
      "null"
     ]
    },
    "anchorDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "anchorGroupId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "bodyOffsetPx": {
     "type": [
      "object",
      "null"
     ],
     "required": [
      "dx",
      "dy"
     ],
     "additionalProperties": false,
     "properties": {
      "dx": {
       "type": "number"
      },
      "dy": {
       "type": "number"
      }
     }
    },
    "strokeColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "strokeWidthPx": {
     "type": [
      "integer",
      "null"
     ]
    },
    "fillColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "fillTransparencyPercent": {
     "type": [
      "integer",
      "null"
     ]
    },
    "textColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    }
   }
  },
