     "type": [
      "string",
      "null"
     ]
    },
    "topGroupId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "bottomGroupId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "strokeColor": {
     "type": [
      "string",
      "null"
     ],
     "pattern": "^(?:white|black|dimgray|lightgray|red|blue|yellow|green|orange|purple|transparent|#[0-9a-fA-F]{6}/(?:#[0-9a-fA-F]{6})?|/#[0-9a-fA-F]{6})$"
    },
    "cornerRadiusPx": {
     "type": [
      "number",
      "null"
     ]
    },
