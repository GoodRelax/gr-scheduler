  "CarryElement": {
   "type": "object",
   "description": "One element of an imported MS Project file that GRS does not interpret, kept as it arrived so that it is written back unchanged.",
   "required": [
    "ordinal",
    "name",
    "fields",
    "children"
   ],
   "additionalProperties": false,
   "properties": {
    "ordinal": {
     "type": "integer"
    },
    "name": {
     "type": "string"
    },
    "fields": {
     "type": "object",
     "additionalProperties": {
      "type": "string"
     }
    },
    "children": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CarryElement"
     }
    }
   }
  },
  "documentStamp": {
   "type": "object",
   "description": "When the document last changed and was saved, and who wrote it last.",
   "required": [
    "scheduleUpdatedUtc",
    "lastEditedBy",
    "settingsUpdatedUtc",
    "fileSavedUtc"
   ],
   "additionalProperties": false,
   "properties": {
