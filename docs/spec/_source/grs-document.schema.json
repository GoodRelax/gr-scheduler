     "type": [
      "string",
      "null"
     ]
    },
    "milestone": {
     "type": [
      "boolean",
      "null"
     ]
    }
   }
  },
  "Carry": {
   "type": "object",
   "description": "Values of an imported MS Project element that GRS does not interpret, kept to write them back unchanged; {} when nothing was imported.",
