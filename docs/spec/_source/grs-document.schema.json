   ],
   "additionalProperties": false,
   "properties": {
    "ordinal": {
     "type": "integer"
    },
    "name": {
     "type": [
      "string",
      "null"
     ]
    },
    "fromDate": {
     "description": "For a one-off exception (see recurrenceKind) fromDate..toDate is the real range of days, written 00:00:00 and 23:59:00, and its workingTimes replace that day's spans; for a recurring one it is MS Project's start of the recurrence, not a range of real days.",
     "$ref": "#/$defs/DateTime"
    },
