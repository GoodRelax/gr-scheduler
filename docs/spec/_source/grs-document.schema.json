     "type": "string",
     "format": "date-time",
     "$comment": "ISO 8601, UTC, to the second."
    },
    "lastEditedBy": {
     "type": "string"
    },
    "settingsUpdatedUtc": {
     "type": "string",
     "format": "date-time",
     "$comment": "ISO 8601, UTC, to the second."
    },
    "fileSavedUtc": {
     "type": [
      "string",
      "null"
     ],
     "format": "date-time",
     "$comment": "ISO 8601, UTC, to the second."
    }
   }
  },
  "changeLog": {
   "type": "object",
   "description": "Why a change was made; the conversation that led to it is not stored.",
   "required": [
    "ordinal",
