    "arrowHeadOfStroke": {
     "type": "number",
     "minimum": 1.5,
     "maximum": 8
    },
    "assigneeVisible": {
     "type": "boolean"
    },
    "autosaveIdleMs": {
     "type": "integer",
     "minimum": 300,
     "maximum": 10000
