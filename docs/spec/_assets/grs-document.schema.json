    "rulerTierPxPerDayDay": {
     "type": "integer",
     "maximum": 60
    },
    "rulerTierPxPerDayMonth": {
     "type": "number",
     "minimum": 0.1
    },
    "rulerTierPxPerDayWeek": {
     "type": "number"
    },
    "scrollDate": {
     "type": [
      "string",
      "null"
     ]
    },
    "scrollGroupId": {
     "type": [
      "string",
      "null"
     ],
     "format": "uuid"
    },
    "shapeHeightOf": {
     "type": "object",
     "required": [
      "arrow",
      "chevron",
      "endpointSpan",
      "milestone",
      "rectangle"
     ],
