       "type": "object",
       "required": [
        "date1",
        "date2"
       ],
       "additionalProperties": false,
       "properties": {
        "date1": {
         "$comment": "The source does not say what type this holds; its default is written as '`null`'."
        },
        "date2": {
         "$comment": "The source does not say what type this holds; its default is written as '`null`'."
        }
       }
      },
      {
       "type": "null"
      }
     ]
    },
