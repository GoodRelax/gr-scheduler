{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/GoodRelax/gr-scheduler/docs/spec/_assets/grs-document.schema.json",
 "title": "GRS JSON document",
 "description": "Generated from docs/spec/_assets/source/erd.json (the schedule group) and docs/spec/_assets/tbl-settings.md (the presentation group). Never edit by hand: run docs/spec/_assets/source/erd_json_to_schema.py.",
 "$comment": "Settings keys whose own row does not say what type they hold, left unconstrained here: dualCursor.date1, dualCursor.date2, planActualGuidePattern.",
 "type": "object",
 "required": [
  "schemaVersion",
  "schedule",
  "documentSettings",
  "revisionStamp",
  "changeLog"
 ],
 "additionalProperties": false,
 "properties": {
