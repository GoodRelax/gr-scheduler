       "type": "number",
       "minimum": 0.1
      },
      "milestone": {
       "type": "number",
       "maximum": 4
      },
      "rectangle": {
       "type": "number",
       "minimum": 1,
       "maximum": 1
      }
     }
    },
    "spanDotOfStroke": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 4
