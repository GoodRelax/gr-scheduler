     "type": "number",
     "minimum": 0.05,
     "maximum": 1
    },
    "chevronNotchOfWidth": {
     "type": "number",
     "minimum": 0.05,
     "maximum": 0.5
    },
    "dateGridLinesVisible": {
     "type": "boolean"
    },
