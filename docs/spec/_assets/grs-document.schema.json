     "maximum": 3
    },
    "fontMin": {
     "type": "integer",
     "minimum": 12,
     "maximum": 40
    },
    "fontOfActual": {
     "type": "number",
     "minimum": 0.05
    },
    "fontScale": {
     "enum": [
      "S",
      "M",
      "L"
     ]
    },
    "fontScaleSizes": {
     "type": "object",
     "required": [
      "L",
      "M",
      "S"
     ],
     "additionalProperties": false,
     "properties": {
      "L": {
       "type": "integer",
       "maximum": 40
      },
      "M": {
       "type": "integer"
      },
      "S": {
       "type": "integer"
      }
     }
    },
    "groupGridLinesVisible": {
