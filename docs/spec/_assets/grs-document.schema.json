   "type": "string"
  },
  "schedule": {
   "type": "object",
   "description": "日程データの群（表 T-052 の `DR-2`）。",
   "required": [
    "project",
    "calendars",
    "tasks",
    "resources",
    "assignments",
    "taskGroups",
    "taskGroupMembers",
    "taskVisuals",
    "commentBoxes",
    "highlightBoxes",
    "taskOrigins",
    "baselineTasks"
   ],
   "additionalProperties": false,
   "properties": {
    "project": {
     "$ref": "#/$defs/Project"
    },
    "calendars": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Calendar"
     }
    },
    "tasks": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Task"
     }
    },
    "resources": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Resource"
     }
    },
    "assignments": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/Assignment"
     }
    },
    "taskGroups": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskGroup"
     }
    },
    "taskGroupMembers": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskGroupMember"
     }
    },
    "taskVisuals": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/TaskVisual"
     }
    },
    "commentBoxes": {
     "type": "array",
     "items": {
      "$ref": "#/$defs/CommentBox"
