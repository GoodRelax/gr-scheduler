     "minimum": 1,
     "maximum": 256
    },
    "importMaxDate": {
     "type": "string",
     "format": "date"
    },
    "importMaxDepth": {
     "type": "integer",
     "minimum": 8,
     "maximum": 256
    },
    "importMaxItems": {
     "type": "integer",
     "minimum": 1000,
     "maximum": 200000
    },
    "importMinDate": {
     "type": "string",
     "format": "date"
    },
    "labelBaseline": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.8
    },
    "labelCoef": {
     "type": "number",
     "minimum": 0.3,
     "maximum": 1
    },
    "labelGap": {
     "type": "integer",
     "minimum": 0,
     "maximum": 30
    },
    "labelHaloOfFont": {
     "type": "number",
     "minimum": 0,
     "maximum": 0.3
    },
    "labelPad": {
     "type": "integer",
     "minimum": 0,
     "maximum": 30
    },
    "markerGap": {
     "type": "integer",
     "minimum": 4,
     "maximum": 4
    },
    "markerSize": {
     "type": "integer"
    },
    "markerStroke": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 4
    },
    "maxGroupDepth": {
     "type": "integer",
     "minimum": 3,
     "maximum": 8
    },
    "milestoneActualDuration": {
     "type": "integer",
     "minimum": 0,
     "maximum": 0
    },
    "minShapeWidth": {
     "type": "integer",
     "minimum": 1,
     "maximum": 20
    },
    "percentCompleteVisible": {
     "type": "boolean"
    },
    "pinnedGroupIds": {
     "type": "array",
     "items": {
      "type": "string",
      "format": "uuid"
     }
    },
    "pinnedRowMax": {
     "type": "integer"
    },
    "planActualDisplay": {
     "enum": [
      "both",
      "plan-only",
      "actual-only"
     ]
    },
    "planActualGuidePattern": {
     "$comment": "The source does not say what type this holds; its default is written as '`2,2`'."
    },
    "planActualGuideWeight": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 2
    },
    "planStroke": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    },
    "progressLineOverhang": {
     "type": "integer",
     "minimum": 0,
     "maximum": 40
    },
    "progressLineVisible": {
     "type": "boolean"
    },
    "progressLineWidth": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 8
    },
    "progressMarkerVisible": {
     "type": "boolean"
    },
    "propertyPanelWidth": {
     "type": "number"
    },
    "pxPerDayAt1x": {
     "type": "number",
     "minimum": 0.5,
     "maximum": 60
    },
    "resumeArmOfMarker": {
     "type": "number",
     "minimum": 0.2
    },
    "resumeDashOff": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12
    },
    "resumeDashOn": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12
    },
    "resumeHeadOfMarker": {
     "type": "number",
     "minimum": 0.05,
     "maximum": 0.5
    },
    "resumeScaleInvalid": {
     "type": "number",
     "minimum": 0.3,
     "maximum": 1
    },
    "rowGap": {
     "type": "integer",
     "minimum": 0,
     "maximum": 60
    },
    "rowTitleFont": {
     "type": "integer",
     "maximum": 40
    },
    "rowTitleIndent": {
     "type": "integer",
     "minimum": 0,
     "maximum": 60
    },
    "rowTitlePanelWidth": {
     "type": "number"
    },
    "rowTitleTopScale": {
     "type": "number",
     "minimum": 1,
     "maximum": 2
    },
    "rulerFont": {
     "type": "number"
    },
    "rulerHeight": {
     "type": "number",
     "maximum": 150
