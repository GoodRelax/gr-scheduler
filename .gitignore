# ---- Dependencies / build output ----
node_modules/
dist/
build/
.vite/
_site/

# ---- Test artifacts ----
coverage/
playwright-report/
test-results/
.nyc_output/

# ---- StrictDoc ----
# Export target of `strictdoc export docs/spec --output-dir docs/spec/output`.
docs/spec/output/
__pycache__/

# ---- Third-party reference copies ------------------------------------------
# docs/reference/ holds the external primary sources this project checks its
# claims against: the MSPDI schema, the Microsoft Learn element reference and
# the WCAG 2.1 text. Nothing third-party is redistributed here, including
# CC-BY material, so only the README pointer of each folder is tracked and the
# copies are fetched locally by whoever needs them. A folder added later is
# excluded without editing this file, so the safe direction is the automatic one.
docs/reference/**
!docs/reference/**/
!docs/reference/**/README.md

# The same rule for the frozen input set. It carries no copies of its own -- the
# README below is a pointer to docs/reference/mspdi/ -- but keep the net in place
# so a stray re-fetch there cannot be committed by accident.
previous-project-result/01-mspdi/mspdi/*
!previous-project-result/01-mspdi/mspdi/README.md

# ---- Internal working notes. Never published. ----
previous-project-result/temp/
# Scratch copies of documents that are still being edited elsewhere in the tree.
temp/

# ---- Secrets ----
.env
.env.*
*.pem
*.key

# ---- Local tooling state ----
.claude/settings.local.json
# Workflow subagent worktrees. Untracked scratch, but tools/precheck.py reads
# git status and would otherwise count every file inside them as a trap while
# a workflow is still running.
.claude/worktrees/

# ---- Editor / OS / scratch ----
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.bak
# *.bak alone does not match the dated form the editor writes (*.bak-20260815-090337),
# and _assets/ is copied verbatim into the HTML export -- a stale copy of the
# specification shipped to every reader until it was noticed.
*.bak-*
*.orig
*.tmp
*~
*.log
npm-debug.log*
scratch/
tmp/

# Documents saved out of the running app. These are the reader's own
# schedules, not the project's -- and this repository is public.
sample-schedule/
