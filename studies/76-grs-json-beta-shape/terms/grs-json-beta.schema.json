          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "freePoint",
                "task",
                "highlightBox"
              ]
            },
            "dateTime": {
              "$ref": "#/$defs/DateTime"
            },
            "taskGroupId": {
              "$ref": "#/$defs/Uuid"
            },
            "taskGroupTopOffsetPercent": {
              "type": "number"
            },
            "taskUid": {
              "$ref": "#/$defs/Uid"
            },
            "snapPart": {
              "type": "string",
              "enum": [
                "planBar",
                "actualBar",
                "milestoneMark"
              ]
            },
            "highlightBoxId": {
              "$ref": "#/$defs/Uuid"
            },
            "snapPoint": {
              "type": "string",
              "enum": [
                "topLeftCorner",
                "topMiddle",
                "topRightCorner",
                "rightMiddle",
                "bottomRightCorner",
                "bottomMiddle",
                "bottomLeftCorner",
                "leftMiddle"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "freePoint"
                  }
                }
              },
              "then": {
                "required": [
                  "dateTime",
                  "taskGroupId",
                  "taskGroupTopOffsetPercent"
                ],
                "properties": {
                  "taskUid": false,
                  "snapPart": false,
                  "snapPoint": false,
                  "highlightBoxId": false
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "task"
                  }
                }
              },
              "then": {
                "required": [
                  "taskUid",
                  "snapPart",
                  "snapPoint"
                ],
                "properties": {
                  "dateTime": false,
                  "taskGroupId": false,
                  "taskGroupTopOffsetPercent": false,
                  "highlightBoxId": false
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "highlightBox"
                  }
                }
              },
              "then": {
                "required": [
                  "highlightBoxId",
                  "snapPoint"
                ],
                "properties": {
                  "dateTime": false,
                  "taskGroupId": false,
                  "taskGroupTopOffsetPercent": false,
                  "taskUid": false,
                  "snapPart": false
                }
              }
            }
          ]
        },
