          }
        },
        "columnFilters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ColumnFilter"
          }
        },
        "columnSort": {
          "$ref": "#/$defs/ColumnSort"
        }
      },
      "additionalProperties": false
