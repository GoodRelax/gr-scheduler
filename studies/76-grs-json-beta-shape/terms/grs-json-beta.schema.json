            "dumbbell"
          ]
        },
        "milestoneShape": {
          "type": "string",
          "enum": [
            "circle",
            "hexagon",
            "pentagon",
            "diamond",
            "square",
            "star",
            "triangleUp",
            "triangleDown",
            "file",
            "box",
            "floppyDisk",
            "cylinder",
            "meetingPeople",
            "smilingFace",
            "beerMug"
