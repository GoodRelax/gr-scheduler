{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goodrelax.github.io/gr-scheduler/spec/_source/grs-document.schema.json",
  "$comment": "HAND-WRITTEN CONTRACT -- EDIT THIS FILE. The beta shape of GRS JSON (CR-851), written from the accepted tree grs-json-final-review-tree.md and the sample grs-json-beta-sample.json (rulings JDG-3566..3756). Until CR-851 moves this shape into docs/spec/_source (erd.json, settings.json and their generator), this file is the source of the beta shape; compare_schemas.py is the gate between the two. The review tree is generated from this file: python schema_to_review_tree.py write. Status 2026-11-23: structure, order and enumeration values are final; descriptions marked TODO and value bounds are being written.",
  "title": "GRS JSON document",
  "description": "TODO root description",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersionUtc": {
      "$ref": "#/$defs/UtcDateTime"
    },
    "buildVersionUtc": {
      "$ref": "#/$defs/UtcDateTime"
    },
    "documentStamp": {
      "$ref": "#/$defs/DocumentStamp"
    },
    "documentSettings": {
      "type": "object",
      "properties": {
        "displayScaleRatio": {
          "type": "number"
        },
        "fontSizePreset": {
          "type": "string",
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "isThemeMonochrome": {
          "type": "boolean"
        },
        "themeHue": {
          "type": "string",
          "enum": [
            "blue",
            "blueGreen",
            "green",
            "yellowGreen",
            "yellow",
            "orange",
            "red",
            "redPurple",
            "purple",
            "indigo"
          ]
        },
        "viewTimeZone": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "sameAsScheduleData",
                "fixed"
              ]
            },
            "utcOffset": {
              "$ref": "#/$defs/UtcOffset"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "sameAsScheduleData"
                  }
                }
              },
              "then": {
                "properties": {
                  "utcOffset": false
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "fixed"
                  }
                }
              },
              "then": {
                "required": [
                  "utcOffset"
                ]
              }
            }
          ]
        },
        "additionalTimeZones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "utcOffset": {
                "$ref": "#/$defs/UtcOffset"
              },
              "zoneNameType": {
                "type": "string",
                "enum": [
                  "standard",
                  "daylight"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "isTimeOfDayVisible": {
          "type": "boolean"
        },
        "dayWidthPx": {
          "type": "number"
        },
        "fitDayRange": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "fixed",
                "automatic"
              ]
            },
            "firstDay": {
              "$ref": "#/$defs/Day"
            },
            "lastDay": {
              "$ref": "#/$defs/Day"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "fixed"
                  }
                }
              },
              "then": {
                "required": [
                  "firstDay",
                  "lastDay"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "automatic"
                  }
                }
              },
              "then": {
                "properties": {
                  "firstDay": false,
                  "lastDay": false
                }
              }
            }
          ]
        },
        "verticalZoom": {
          "type": "object",
          "properties": {
            "ratio": {
              "type": "number"
            },
            "automaticallyShownDepth": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "taskGroupPanelWidthPx": {
          "type": "number"
        },
        "isTaskGroupPanelWidthFixed": {
          "type": "boolean"
        },
        "pinnedTaskGroupIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          }
        },
        "taskPlacementDirection": {
          "type": "string",
          "enum": [
            "bottomToTop",
            "topToBottom"
          ]
        },
        "scrollPosition": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "automatic",
                "fixed"
              ]
            },
            "leftEdgeDay": {
              "$ref": "#/$defs/Day"
            },
            "leftEdgeDayOffsetPercent": {
              "type": "number"
            },
            "topEdgeTaskGroupId": {
              "$ref": "#/$defs/Uuid"
            },
            "topEdgeTaskGroupOffsetPercent": {
              "type": "number"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "automatic"
                  }
                }
              },
              "then": {
                "properties": {
                  "leftEdgeDay": false,
                  "leftEdgeDayOffsetPercent": false,
                  "topEdgeTaskGroupId": false,
                  "topEdgeTaskGroupOffsetPercent": false
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "fixed"
                  }
                }
              },
              "then": {
                "required": [
                  "leftEdgeDay",
                  "leftEdgeDayOffsetPercent",
                  "topEdgeTaskGroupId",
                  "topEdgeTaskGroupOffsetPercent"
                ]
              }
            }
          ]
        },
        "scheduleCanvasElements": {
          "type": "object",
          "properties": {
            "isPlanBarVisible": {
              "type": "boolean"
            },
            "isActualBarVisible": {
              "type": "boolean"
            },
            "isBaselineOutlineVisible": {
              "type": "boolean"
            },
            "isAssigneeLabelVisible": {
              "type": "boolean"
            },
            "isPercentCompleteLabelVisible": {
              "type": "boolean"
            },
            "isProgressStatusMarkVisible": {
              "type": "boolean"
            },
            "isPlanDatesVisible": {
              "type": "boolean"
            },
            "isDependencyLineVisible": {
              "type": "boolean"
            },
            "isProgressLineVisible": {
              "type": "boolean"
            },
            "isDateGridLinesVisible": {
              "type": "boolean"
            },
            "isTaskGroupGridLinesVisible": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "delayDiagnosisSettings": {
          "type": "object",
          "properties": {
            "parentTaskProgressToleranceWorkingDays": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "tableWindows": {
          "type": "object",
          "properties": {
            "searchWindow": {
              "$ref": "#/$defs/TaskTableWindow"
            },
            "delayDiagnosisReportWindow": {
              "$ref": "#/$defs/TaskTableWindow"
            },
            "resourceListWindow": {
              "$ref": "#/$defs/ResourceTableWindow"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "scheduleData": {
      "type": "object",
      "properties": {
        "scheduleDataTimeZone": {
          "type": "object",
          "properties": {
            "utcOffset": {
              "$ref": "#/$defs/UtcOffset"
            }
          },
          "additionalProperties": false
        },
        "sourceFormat": {
          "type": "string",
          "enum": [
            "grs",
            "mspdi12",
            "mspdi15"
          ]
        },
        "importedTopTaskOutlineLevel": {
          "type": "integer"
        },
        "mspdiImportCount": {
          "type": "integer"
        },
        "highestIssuedUid": {
          "$ref": "#/$defs/Uid"
        },
        "project": {
          "$ref": "#/$defs/Project",
          "description": "Same as MSPDI Project."
        },
        "calendars": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Calendar"
          },
          "description": "Same as MSPDI Calendars."
        },
        "passthroughCalendars": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "precedingCalendarUid": {
                "$ref": "#/$defs/Uid"
              },
              "mspdiElement": {
                "$ref": "#/$defs/MspdiElement"
              }
            },
            "additionalProperties": false
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Task"
          },
          "description": "Same as MSPDI Tasks."
        },
        "passthroughTasks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "precedingTaskUid": {
                "$ref": "#/$defs/Uid"
              },
              "mspdiElement": {
                "$ref": "#/$defs/MspdiElement"
              }
            },
            "additionalProperties": false
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          },
