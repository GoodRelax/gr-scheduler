    "ColumnFilter": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "values",
            "dateRange"
          ]
        },
        "column": {
          "type": "string",
          "enum": [
            "progressStatus",
            "percentComplete",
            "taskType",
            "taskName",
            "resourceNames",
            "start",
            "finish",
            "actualStart",
            "actualFinish",
            "taskGroupPath",
            "text",
            "taskGroupName",
            "leaderTargetDay",
            "diagnosisStatus",
            "planDates",
            "actualDates",
            "diagnosisReason",
            "resourceSelectionStatus",
            "resourceName",
            "assignedTaskCount",
            "assignedTaskNames"
          ]
        },
        "hiddenValues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "isBlankHidden": {
          "type": "boolean"
        },
        "firstDay": {
          "$ref": "#/$defs/Day"
        },
        "lastDay": {
          "$ref": "#/$defs/Day"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "values"
              }
            }
          },
          "then": {
            "required": [
              "hiddenValues",
              "isBlankHidden"
            ],
            "properties": {
              "firstDay": false,
              "lastDay": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dateRange"
              }
            }
          },
          "then": {
            "required": [
              "firstDay",
              "lastDay"
            ],
            "properties": {
              "hiddenValues": false,
              "isBlankHidden": false
            }
          }
        }
      ]
    },
    "ColumnSort": {
      "type": "object",
      "properties": {
        "column": {
          "$ref": "#/$defs/ColumnFilter/properties/column"
        },
        "direction": {
          "type": "string",
          "enum": [
            "ascending",
            "descending"
          ]
