{
  "name": "gr-scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "GoodRelax Scheduler (GRS) -- a schedule editor that draws what it is told and hands the file back unchanged.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.entity.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "e2e": "playwright test --pass-with-no-tests",
    "gen": "npm run gen:settings && npm run gen:md && npm run gen:schema && npm run types && npm run tree && npm run startup && npm run icons && npm run glyphs && npm run words && npm run mspdi && npm run formats",
    "gen:check": "npm run gen:settings:check && npm run gen:md:check && npm run gen:schema:check && npm run types:check && npm run tree:check && npm run startup:check && npm run icons:check && npm run glyphs:check && npm run words:check && npm run mspdi:check && npm run formats:check",
    "gen:settings": "python docs/spec/_source/settings_json_to_md.py",
    "gen:settings:check": "python docs/spec/_source/settings_json_to_md.py --check",
    "gen:md": "python docs/spec/_source/erd_json_to_md.py",
    "gen:md:check": "python docs/spec/_source/erd_json_to_md.py --check",
    "gen:schema": "python docs/spec/_source/erd_json_to_schema.py",
    "gen:schema:check": "python docs/spec/_source/erd_json_to_schema.py --check",
    "tree": "python tools/generate_unit_tree.py",
    "tree:check": "python tools/generate_unit_tree.py --check",
    "types": "python tools/generate_entity_types.py",
    "types:check": "python tools/generate_entity_types.py --check",
    "precheck": "python tools/precheck.py",
    "layers": "python tools/check_layer_rules.py",
    "startup": "python tools/generate_startup_template.py",
    "startup:check": "python tools/generate_startup_template.py --check",
    "icons": "python tools/generate_icon_roster.py",
    "icons:check": "python tools/generate_icon_roster.py --check",
    "glyphs": "python tools/generate_icon_glyphs.py",
    "glyphs:check": "python tools/generate_icon_glyphs.py --check",
    "words": "python tools/generate_display_words.py",
    "words:check": "python tools/generate_display_words.py --check",
    "mspdi": "python tools/generate_mspdi_custom_fields.py",
    "mspdi:check": "python tools/generate_mspdi_custom_fields.py --check",
    "formats": "python tools/generate_exchange_formats.py",
    "formats:check": "python tools/generate_exchange_formats.py --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
