{
  "name": "gr-scheduler",
  "version": "0.0.0",
  "private": true,
  "description": "GoodRelax Scheduler (GRS) -- a schedule editor that draws what it is told and hands the file back unchanged.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "vite build",
    "check": "bash .claude/skills/spec-graph-check/check.sh",
    "dev": "vite",
    "e2e": "playwright test --pass-with-no-tests",
    "follow": "python tools/follow_the_manuscript.py --all",
    "formats": "python tools/generate_exchange_formats.py",
    "formats:check": "python tools/generate_exchange_formats.py --check",
    "gen": "npm run gen:settings && npm run gen:items && npm run gen:md && npm run gen:schema && npm run types && npm run validator && npm run tree && npm run startup && npm run icons && npm run propitems && npm run helproster && npm run licence && npm run glyphs && npm run words && npm run mspdi && npm run formats",
    "gen:check": "npm run gen:settings:check && npm run gen:items:check && npm run gen:md:check && npm run gen:schema:check && npm run types:check && npm run validator:check && npm run tree:check && npm run startup:check && npm run icons:check && npm run propitems:check && npm run helproster:check && npm run licence:check && npm run glyphs:check && npm run words:check && npm run mspdi:check && npm run formats:check",
    "gen:items": "python docs/spec/_source/property_items_json_to_md.py",
    "gen:items:check": "python docs/spec/_source/property_items_json_to_md.py --check",
    "gen:md": "python docs/spec/_source/erd_json_to_md.py",
    "gen:md:check": "python docs/spec/_source/erd_json_to_md.py --check",
    "gen:schema": "python docs/spec/_source/erd_json_to_schema.py",
    "gen:schema:check": "python docs/spec/_source/erd_json_to_schema.py --check",
    "gen:settings": "python docs/spec/_source/settings_json_to_md.py",
    "gen:settings:check": "python docs/spec/_source/settings_json_to_md.py --check",
    "glyphs": "python tools/generate_icon_glyphs.py",
    "glyphs:check": "python tools/generate_icon_glyphs.py --check",
    "guard:cleanup": "python .claude/skills/spec-graph-check/list-asserted-claims.py && python .claude/skills/spec-graph-check/list-withdrawn-cited.py && python .claude/skills/spec-graph-check/list-prose-tallies.py && python .claude/skills/spec-graph-check/list-inverted-authority.py && python .claude/skills/spec-graph-check/list-lying-edges.py",
    "guard:commit": "npm run precheck && npm run typecheck && npm run gen:check && npm run test && npm run check",
    "guard:gen": "npm run gen && npm run gen:check && npm run test && npm run check",
    "guard:publish": "python tools/precheck.py --unpushed && npm run guard:commit",
    "guard:spec": "npm run precheck && npm run test && npm run check",
    "guard:start": "npm run sweep && npm run stats && npm run precheck",
    "helproster": "python tools/generate_help_roster.py",
    "helproster:check": "python tools/generate_help_roster.py --check",
    "icons": "python tools/generate_icon_roster.py",
    "icons:check": "python tools/generate_icon_roster.py --check",
    "layers": "python tools/check_layer_rules.py",
    "licence": "python tools/generate_licence.py",
    "licence:check": "python tools/generate_licence.py --check",
    "linebreaks": "python tools/fix_line_breaks.py --all",
    "linebreaks:check": "python .claude/skills/spec-graph-check/check-line-breaks.py",
    "marks:check": "python .claude/skills/spec-graph-check/check-marks.py",
    "mspdi": "python tools/generate_mspdi_custom_fields.py",
    "mspdi:check": "python tools/generate_mspdi_custom_fields.py --check",
    "parity": "node tools/parity/check.mjs",
    "precheck": "python tools/precheck.py",
    "preview": "vite preview",
    "propitems": "python tools/generate_property_items.py",
    "propitems:check": "python tools/generate_property_items.py --check",
    "render:check": "python .claude/skills/spec-graph-check/check-render.py",
    "startup": "python tools/generate_startup_template.py",
    "startup:check": "python tools/generate_startup_template.py --check",
    "stats": "python tools/collect_stats.py",
    "sweep": "python tools/sweep_strictdoc_output.py",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "tree": "python tools/generate_unit_tree.py",
    "tree:check": "python tools/generate_unit_tree.py --check",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.entity.json --noEmit",
    "types": "python tools/generate_entity_types.py",
    "types:check": "python tools/generate_entity_types.py --check",
    "validator": "python tools/generate_json_schema_validator.py",
    "validator:check": "python tools/generate_json_schema_validator.py --check",
    "words": "python tools/generate_display_words.py",
    "words:check": "python tools/generate_display_words.py --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
